# Antarman environment template
# Copy this file to .env and fill in your real keys.

# AI Provider Keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# Whisper local runtime
WHISPER_PATH=C:\whisper\whisper-cli.exe
WHISPER_MODEL_PATH=C:\whisper\models\ggml-base.en.bin

# Local TTS server
TTS_SERVER_URL=http://127.0.0.1:5050

# Optional custom settings
VITE_APP_NAME=Antarman
